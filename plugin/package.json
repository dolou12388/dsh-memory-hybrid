{
  "name": "dsh-memory-hybrid",
  "version": "0.2.3",
  "description": "混合架构大模型记忆：KV 权威层 + 向量派生索引 + 艾宾浩斯衰减 + 可选 Jev 判别",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client.js",
    "vendor",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "install": {
      "preferred": "link"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "dshTarget": "0.2.0-rc.2",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "memory",
    "long-term-memory",
    "ebbinghaus",
    "spaced-repetition",
    "sqlite",
    "deepseek-harness"
  ],
  "license": "MIT"
}
